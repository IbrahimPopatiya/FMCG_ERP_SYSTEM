# Copy this file to .env and fill in your own local values.
# .env is not committed to Git - each developer creates their own.

# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# App runtime DB — can be local or a deployed Supabase URL.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/dms_db

# Pytest ALWAYS uses this local DB — never DATABASE_URL — so you can point
# the app at Supabase while tests stay fast on your machine.
# Create once: createdb -h localhost -U postgres dms_test_db
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/dms_test_db

# Used to sign login (JWT) tokens - use a long random string, especially in production
SECRET_KEY=change-this-to-a-random-secret

# How long a login token stays valid, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Extra CORS origins to allow, comma-separated - e.g. your laptop's LAN IP
# when testing the frontend from a phone or another device on the same WiFi.
# Leave blank for normal localhost-only development.
CORS_EXTRA_ORIGINS=

# Supabase project URL (Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service_role secret key (Settings -> API) - used server-side only
# to upload files, bypassing RLS. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=change-this-to-your-service-role-key

# Supabase Storage bucket where uploaded files (signatures, photos, product
# images) are stored
SUPABASE_STORAGE_BUCKET=fmcg_products
