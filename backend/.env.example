# Copy this file to .env and fill in your own local values.
# .env is not committed to Git - each developer creates their own.

# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# App runtime DB — can be local or a deployed Supabase URL.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/dms_db

# Optional — used only for running Alembic migrations. If DATABASE_URL points
# at Supabase's transaction pooler (port 6543), set this to the direct
# connection or session pooler instead (port 5432). The transaction pooler
# doesn't guarantee multi-statement DDL transactions stay atomic, which can
# leave a migration half-applied (table created, alembic_version not bumped).
# Leave blank to just reuse DATABASE_URL.
DIRECT_DATABASE_URL=

# Pytest ALWAYS uses this local DB — never DATABASE_URL — so you can point
# the app at Supabase while tests stay fast on your machine.
# Create once: createdb -h localhost -U postgres dms_test_db
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/dms_test_db

# Used to sign login (JWT) tokens - use a long random string, especially in production
SECRET_KEY=change-this-to-a-random-secret

# How long a login token stays valid, in minutes. Kept in sync with the
# frontend's 7-day session cookie (frontend/lib/auth/session.ts) - a shorter
# value here logs the user out well before that cookie expires.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Extra CORS origins to allow, comma-separated - e.g. your laptop's LAN IP
# when testing the frontend from a phone or another device on the same WiFi,
# or a client's production Vercel domain (custom domain or *.vercel.app).
# Leave blank for normal localhost-only development.
CORS_EXTRA_ORIGINS=

# Regex matching this client's Vercel preview deploy URLs. Set to this
# client's own Vercel project name - defaults to the original project.
CORS_VERCEL_PREVIEW_REGEX=

# AWS S3 file storage (signatures, photos, product images, posters).
# Access key of an IAM user allowed only s3:PutObject + s3:GetObject on this
# bucket - used server-side only. Never expose these to the frontend.
AWS_ACCESS_KEY_ID=change-this-to-your-access-key-id
AWS_SECRET_ACCESS_KEY=change-this-to-your-secret-access-key
AWS_REGION=ap-south-1
# One bucket per client deployment, with public read on objects
S3_BUCKET_NAME=your-client-bucket

# Optional - CloudFront domain in front of the bucket (e.g. d1234.cloudfront.net).
# When set, file URLs use it instead of the plain S3 URL. Leave blank otherwise.
CLOUDFRONT_DOMAIN=

# OpenAI API key - used server-side only to generate poster feature images
# (AI Poster Generator, admin > Poster AI). Get one at platform.openai.com.
OPENAI_API_KEY=change-this-to-your-openai-api-key

# Logging (stdout only — not written to Postgres)
# development → human-readable text; production + LOG_FORMAT=auto → JSON lines
ENVIRONMENT=development
LOG_LEVEL=INFO
# auto | json | text
LOG_FORMAT=auto
