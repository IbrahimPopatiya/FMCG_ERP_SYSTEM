# Copy this file to .env and fill in your own local values.
# .env is not committed to Git - each developer creates their own.

# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# Point this at your Supabase project's connection string (Project Settings >
# Database > Connection string) instead of a local Postgres to test against
# a managed DB. Swapping vendors later is just changing this one value.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/dms_db

# Used to sign login (JWT) tokens - use a long random string, especially in production
SECRET_KEY=change-this-to-a-random-secret

# How long a login token stays valid, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File storage - S3-compatible object storage for uploaded files (signatures,
# photos, product images). Works with Supabase Storage, Cloudflare R2, AWS S3,
# or GCS - switching vendors only means changing these values, not the code.
#
# Supabase Storage setup: Project Settings > Storage > S3 Connection gives you
# the endpoint URL and region; create an access key under "S3 Access Keys" for
# the id/secret.
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
STORAGE_REGION=
# Public URL prefix used to build the file_url returned to callers, e.g.
# https://<project-ref>.supabase.co/storage/v1/object/public/<bucket-name>
STORAGE_PUBLIC_BASE_URL=

# Extra CORS origins to allow, comma-separated - e.g. your laptop's LAN IP
# when testing the frontend from a phone or another device on the same WiFi.
# Leave blank for normal localhost-only development.
CORS_EXTRA_ORIGINS=
