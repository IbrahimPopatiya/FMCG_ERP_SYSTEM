NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Your laptop's LAN IP, only needed when testing the app from a phone or
# another device on the same WiFi (see next.config.ts allowedDevOrigins).
# Leave blank for normal localhost-only development.
DEV_LAN_IP=

# Per-client branding — this same codebase is deployed once per client, each
# as its own Render service pointed at its own Supabase DB. Set these per
# deployment so the name/PWA metadata match that client. Leave unset to keep
# the Zaid Traders defaults (see lib/branding.ts).
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_SHORT_NAME=
NEXT_PUBLIC_THEME_COLOR=
NEXT_PUBLIC_THEME_BACKGROUND=

# Logo file path under /public. Swap the actual image file per client's
# deployment (public/logo-mark.png, icons) — this var only needs to change if
# a client's logo file uses a different filename.
NEXT_PUBLIC_LOGO_PATH=

# Set these if the logo file itself is a full wordmark (already shows the
# brand name/aspect ratio differs from the default 579x355 icon mark), so
# screens don't render the name a second time next to it.
NEXT_PUBLIC_LOGO_WIDTH=
NEXT_PUBLIC_LOGO_HEIGHT=
NEXT_PUBLIC_LOGO_INCLUDES_NAME=
